{
  "name": "nest-optimizer",
  "version": "0.0.0",
  "private": true,
  "description": "3D print optimizer. Node is only used for the checks under tools/ - the app itself is plain classic scripts served as static files.",
  "scripts": {
    "cth:unit": "sh tools/cth-test/run-all.sh",
    "cth:capture": "node tools/cth-test/capture-check.mjs",
    "3mf:roundtrip": "node tools/3mf-test/roundtrip-check.js",
    "3mf:drive": "node tools/3mf-test/export-drive-check.mjs",
    "selfint:equiv": "node tools/nso_selfint_equiv_test.js",
    "grid:math": "node tools/nso_surface_grid_test.js",
    "grid:wire": "node tools/nso_wire_grid_test.js",
    "grid:plate": "node tools/nso_plate_grid_test.js",
    "seat:gap": "node tools/nso_seat_gap_test.js",
    "seat:align": "node tools/nso_seat_align_test.js",
    "seat:overhang": "node tools/nso_seat_overhang_test.js",
    "seat:side": "node tools/nso_seat_side_test.js",
    "skin:test": "node tools/nso_skin_test.js",
    "seat:curved-audit": "node tools/nso_seat_curved_audit.js",
    "seat:surface": "node tools/nso_seat_surface_test.js",
    "dist:selfcheck": "node tools/nso_soup_distance.js",
    "skin:samples": "node tools/nso_skin_samples.js",
    "centerlock:test": "node tools/nso_center_lock_test.js",
    "carve:audit": "node tools/nso_carve_audit.js",
    "carve:test": "node tools/nso_carve_test.js",
    "measure": "node tools/nso_measure_test.js",
    "wire:scale": "node tools/nso_wire_scale_test.js",
    "test": "node tools/run-tests.mjs"
  },
  "testSteps": [
    "cth:unit",
    "cth:capture",
    "3mf:roundtrip",
    "3mf:drive",
    "selfint:equiv",
    "grid:math",
    "grid:wire",
    "grid:plate",
    "seat:gap",
    "seat:align",
    "seat:overhang",
    "seat:side",
    "skin:test",
    "dist:selfcheck",
    "seat:curved-audit",
    "seat:surface",
    "centerlock:test",
    "carve:test",
    "measure",
    "wire:scale"
  ],
  "devDependencies": {
    "playwright": "1.56.1",
    "three": "0.147.0"
  }
}
